# ═══════════════════════════════════════════════════════════
# QTS Messenger Deployment — Environment Variables Template
# Copy to .env and fill in real values before deploying
# Run scripts/setup.sh — it does this automatically
# ═══════════════════════════════════════════════════════════

# ─── Domains ─────────────────────────────────────────────────
# server_name = what appears in Matrix IDs: @user:messanger.qts.dev
# This is the OLD (misspelled) domain — kept as-is because it's baked into
# every existing user's Matrix ID. Do not change unless starting fresh.
SERVER_NAME=messanger.qts.dev
# Where Synapse API actually runs (subdomain)
SYNAPSE_DOMAIN=matrix.messanger.qts.dev
# The domain the web app itself is served on and calls its own /api/*
# routes against. Separate from SERVER_NAME — the client can live on a
# different (correctly spelled) domain than Synapse's server_name.
WEB_DOMAIN=messenger.qts.dev

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=synapse
POSTGRES_USER=synapse_user
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# ─── Synapse Secrets ──────────────────────────────────────────
# Generate each with: openssl rand -hex 32
# Also used directly by auth-gateway to sign admin-API registration calls.
SYNAPSE_REGISTRATION_SHARED_SECRET=CHANGE_ME_REGISTRATION_SECRET
SYNAPSE_MACAROON_SECRET_KEY=CHANGE_ME_MACAROON_KEY
SYNAPSE_FORM_SECRET=CHANGE_ME_FORM_SECRET

# ─── Web Push (push-gateway) ───────────────────────────────────
# Generate with: docker compose run --rm push-gateway npm run generate-vapid-keys
# (scripts/setup.sh does this automatically)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mail@qts.dev

# ─── Let's Encrypt ────────────────────────────────────────────
CERTBOT_EMAIL=mail@qts.dev
