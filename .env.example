# ═══════════════════════════════════════════════════════════
# Matrix Deployment — Environment Variables Template
# Copy to .env and fill in real values before deploying
# Run scripts/setup.sh — it does this automatically
# ═══════════════════════════════════════════════════════════

# ─── Domains ─────────────────────────────────────────────────
# server_name = what appears in Matrix IDs: @user:messanger.qts.dev
SERVER_NAME=messanger.qts.dev
# Where Synapse API actually runs (subdomain)
SYNAPSE_DOMAIN=matrix.messanger.qts.dev
# Where Cinny web client is served
CINNY_DOMAIN=messanger.qts.dev

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=synapse
POSTGRES_USER=synapse_user
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# ─── Synapse Secrets ──────────────────────────────────────────
# Generate each with: openssl rand -hex 32
SYNAPSE_REGISTRATION_SHARED_SECRET=CHANGE_ME_REGISTRATION_SECRET
SYNAPSE_MACAROON_SECRET_KEY=CHANGE_ME_MACAROON_KEY
SYNAPSE_FORM_SECRET=CHANGE_ME_FORM_SECRET

# ─── Let's Encrypt ────────────────────────────────────────────
CERTBOT_EMAIL=your@email.com
