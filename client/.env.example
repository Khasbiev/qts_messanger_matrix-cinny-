VITE_PUSH_GATEWAY_URL=http://localhost:4000
# The URL Synapse itself calls to deliver a push. Usually the same as
# above, EXCEPT when testing locally against the Dockerized Synapse test
# harness (scripts/dev/local-test-synapse.sh). That container's Twisted-based
# DNS resolver cannot resolve "host.docker.internal" (unlike the container
# OS resolver), so use the Docker Desktop host-gateway's literal IP instead
# (find it with `docker run --rm alpine getent hosts host.docker.internal`,
# e.g. http://192.168.65.254:4000), and add that same IP to Synapse's
# ip_range_whitelist in the local test config — its default SSRF blacklist
# rejects private-range pusher URLs otherwise.
VITE_PUSH_GATEWAY_NOTIFY_URL=http://localhost:4000
VITE_VAPID_PUBLIC_KEY=
VITE_AUTH_GATEWAY_URL=http://localhost:4001
# Overrides matrix.js's hardcoded production homeserver default
# (https://matrix.messanger.qts.dev). Set this when testing locally against
# scripts/dev/local-test-synapse.sh, otherwise login/register calls go to
# production even though auth-gateway registered the account against the
# local harness's Synapse. Leave unset in production.
VITE_HOMESERVER_URL=http://localhost:8008
